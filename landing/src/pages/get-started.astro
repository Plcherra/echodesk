---
const plan = Astro.url.searchParams.get("plan") || "trial";
const planLabel =
  plan === "starter"
    ? "Starter"
    : plan === "growth"
      ? "Growth"
      : plan === "business"
        ? "Business"
        : "14-day free trial";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Get started with EchoDesk</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #14201c;
        --muted: #5a6b64;
        --bg: #f4f7f5;
        --accent: #1f6b4f;
        --line: rgba(20, 32, 28, 0.12);
      }
      body {
        margin: 0;
        min-height: 100vh;
        font-family: Georgia, "Times New Roman", serif;
        background:
          radial-gradient(circle at top left, rgba(31, 107, 79, 0.12), transparent 40%),
          linear-gradient(180deg, #eef5f1, var(--bg));
        color: var(--ink);
      }
      .shell {
        max-width: 640px;
        margin: 0 auto;
        padding: 48px 24px 80px;
      }
      a.back {
        color: var(--muted);
        text-decoration: none;
        font-family: system-ui, sans-serif;
        font-size: 0.9rem;
      }
      h1 {
        font-size: clamp(2rem, 5vw, 2.75rem);
        line-height: 1.1;
        margin: 24px 0 12px;
      }
      .lede {
        color: var(--muted);
        font-size: 1.15rem;
        line-height: 1.55;
        margin: 0 0 28px;
      }
      .steps {
        border-top: 1px solid var(--line);
        padding-top: 8px;
      }
      .step {
        padding: 18px 0;
        border-bottom: 1px solid var(--line);
      }
      .step strong {
        display: block;
        margin-bottom: 6px;
        font-size: 1.05rem;
      }
      .step p {
        margin: 0;
        color: var(--muted);
        line-height: 1.5;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
      }
      a.button {
        display: inline-block;
        text-decoration: none;
        padding: 12px 18px;
        border-radius: 999px;
        font-family: system-ui, sans-serif;
        font-weight: 600;
      }
      a.primary {
        background: var(--accent);
        color: white;
      }
      a.quiet {
        background: transparent;
        color: var(--ink);
        border: 1px solid var(--line);
      }
      .note {
        margin-top: 28px;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <a class="back" href="/">← Back to EchoDesk</a>
      <h1>Create your {planLabel} account in the app</h1>
      <p class="lede">
        EchoDesk signup happens in the mobile app — not by email. After you
        confirm your address, come back to the app to finish onboarding.
      </p>
      <div class="steps">
        <div class="step">
          <strong>1. Open the EchoDesk app</strong>
          <p>Use the installed iOS or Android build on your phone.</p>
        </div>
        <div class="step">
          <strong>2. Tap Start free trial / Create account</strong>
          <p>Sign up with your email and password inside the app.</p>
        </div>
        <div class="step">
          <strong>3. Confirm your email, then return to the app</strong>
          <p>
            The confirmation link opens a short handoff page and then EchoDesk.
            If that fails, open the app and sign in with the same email.
          </p>
        </div>
      </div>
      <div class="actions">
        <a class="button primary" href="echodesk://auth-callback">Open EchoDesk app</a>
        <a class="button quiet" href="mailto:echodesk2@gmail.com?subject=EchoDesk%20help">Email support</a>
      </div>
      <p class="note">
        Need help installing a build? Email
        <a href="mailto:echodesk2@gmail.com">echodesk2@gmail.com</a>.
      </p>
    </div>
  </body>
</html>

---
const title = "Opening EchoDesk…";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #14201c;
        --muted: #5a6b64;
        --bg: #f4f7f5;
        --accent: #1f6b4f;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: Georgia, "Times New Roman", serif;
        background:
          radial-gradient(circle at top left, rgba(31, 107, 79, 0.12), transparent 40%),
          linear-gradient(180deg, #eef5f1, var(--bg));
        color: var(--ink);
        padding: 24px;
      }
      .card {
        max-width: 420px;
        text-align: center;
      }
      h1 {
        font-size: 1.75rem;
        margin: 0 0 12px;
      }
      p {
        color: var(--muted);
        line-height: 1.5;
        margin: 0 0 16px;
      }
      a.button {
        display: inline-block;
        background: var(--accent);
        color: white;
        text-decoration: none;
        padding: 12px 18px;
        border-radius: 999px;
        font-family: system-ui, sans-serif;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Opening EchoDesk…</h1>
      <p>
        Your email is confirmed. We’re sending you back to the app to finish
        setup.
      </p>
      <p>
        <a class="button" id="open-app" href="echodesk://auth-callback">Open EchoDesk</a>
      </p>
      <p>
        If nothing opens, launch the EchoDesk app and sign in with the same email.
      </p>
    </div>
    <script is:inline>
      (function () {
        var q = window.location.search || "";
        var h = window.location.hash || "";
        var target = "echodesk://auth-callback" + q + h;
        var link = document.getElementById("open-app");
        if (link) link.setAttribute("href", target);
        window.location.replace(target);
      })();
    </script>
  </body>
</html>

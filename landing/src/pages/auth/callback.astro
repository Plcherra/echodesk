---
const title = "Opening EchoDesk…";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #14201c;
        --muted: #5a6b64;
        --bg: #f4f7f5;
        --accent: #1f6b4f;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: Georgia, "Times New Roman", serif;
        background:
          radial-gradient(circle at top left, rgba(31, 107, 79, 0.12), transparent 40%),
          linear-gradient(180deg, #eef5f1, var(--bg));
        color: var(--ink);
        padding: 24px;
      }
      .card {
        max-width: 420px;
        text-align: center;
      }
      h1 {
        font-size: 1.75rem;
        margin: 0 0 12px;
      }
      p {
        color: var(--muted);
        line-height: 1.5;
        margin: 0 0 16px;
      }
      a.button {
        display: inline-block;
        background: var(--accent);
        color: white;
        text-decoration: none;
        padding: 14px 22px;
        border-radius: 999px;
        font-family: system-ui, sans-serif;
        font-weight: 600;
        font-size: 1.05rem;
      }
      .hint {
        font-size: 0.95rem;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>Opening EchoDesk…</h1>
      <p>
        Your email is confirmed. Tap below if the app does not open
        automatically (iPhone often requires one tap).
      </p>
      <p>
        <a class="button" id="open-app" href="echodesk://auth-callback">Open EchoDesk</a>
      </p>
      <p class="hint">
        If nothing opens, launch the EchoDesk app and sign in with the same email.
      </p>
    </div>
    <script is:inline>
      (function () {
        // iOS often drops URL hash when opening a custom scheme. Copy token
        // params from the hash into the query string so the app still gets them.
        function buildTarget() {
          var searchParams = new URLSearchParams(
            (window.location.search || "").replace(/^\?/, "")
          );
          var hash = (window.location.hash || "").replace(/^#/, "");
          if (hash) {
            var hashParams = new URLSearchParams(hash);
            hashParams.forEach(function (value, key) {
              if (!searchParams.has(key)) searchParams.set(key, value);
            });
          }
          var qs = searchParams.toString();
          return "echodesk://auth-callback" + (qs ? "?" + qs : "");
        }

        var target = buildTarget();
        var link = document.getElementById("open-app");
        if (link) link.setAttribute("href", target);

        function openApp() {
          try {
            var iframe = document.createElement("iframe");
            iframe.style.display = "none";
            iframe.src = target;
            document.body.appendChild(iframe);
            setTimeout(function () {
              try {
                document.body.removeChild(iframe);
              } catch (_) {}
            }, 2000);
          } catch (_) {}
          try {
            window.location.href = target;
          } catch (_) {}
        }

        openApp();
        setTimeout(openApp, 500);
        setTimeout(openApp, 1500);
      })();
    </script>
  </body>
</html>
